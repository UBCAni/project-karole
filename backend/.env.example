MAX_NAME_LENGTH=30
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<enter-password>
JWT_SECRET=<replace-this-with-a-long-random-secret>
# Optional. Full path to a cookies.txt from a throwaway YouTube account, used to retry YouTube
# lookups that fail (YouTube often asks servers to "confirm you are not a bot"). Keep the file
# outside the project folder and never commit it. See "Running on a server" in the frontend README.
YTDLP_COOKIE_FILE=

# Optional. A YouTube Data API v3 key, used to look up a song being added when yt-dlp (with and
# without the cookies file) is refused. Free: about 10,000 units a day, 1 per added song. See
# "Running on a server" in the frontend README. Never commit the real key.
YOUTUBE_API_KEY=
